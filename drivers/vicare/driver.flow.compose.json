{
  "conditions": [
    {
      "id": "compressor-is-running",
      "title": {
        "en": "Compressor is !{{running|not running}}"
      },
      "titleFormatted": {
        "en": "Compressor is !{{running|not running}}"
      },
      "args": [],
      "hint": {
        "en": "Checking last known state, i.e. could return incorrect value if not recently synced."
      }
    },
    {
      "id": "burner-is-running",
      "title": {
        "en": "Burner is !{{running|not running}}"
      },
      "titleFormatted": {
        "en": "Burner is !{{running|not running}}"
      },
      "args": [],
      "hint": {
        "en": "Checking last known state, i.e. could return incorrect value if not recently synced."
      }
    }
  ],
  "actions": [
    {
      "id": "set-operating-mode",
      "title": {
        "en": "Set operating mode to [[mode]]"
      },
      "titleFormatted": {
        "en": "Set operating mode to [[mode]]"
      },
      "args": [
        {
          "name": "mode",
          "type": "dropdown",
          "values": [
            {
              "id": "dhw",
              "title": {
                "en": "Hot water only"
              }
            },
            {
              "id": "heating",
              "title": {
                "en": "Heating only"
              }
            },
            {
              "id": "dhwAndHeating",
              "title": {
                "en": "Hot water and heating"
              }
            },
            {
              "id": "standby",
              "title": {
                "en": "Standby"
              }
            }
          ]
        }
      ],
      "hint": {
        "en": "Note: Not all operating modes are supported by all installations"
      }
    },
    {
      "id": "set-heating-program",
      "title": {
        "en": "Set heating program"
      },
      "titleFormatted": {
        "en": "Set heating program to [[program]]"
      },
      "args": [
        {
          "name": "program",
          "type": "dropdown",
          "values": [
            {
              "id": "comfort",
              "title": {
                "en": "Comfort"
              }
            },
            {
              "id": "normal",
              "title": {
                "en": "Normal"
              }
            },
            {
              "id": "eco",
              "title": {
                "en": "Eco (reduced)"
              }
            },
            {
              "id": "auto",
              "title": {
                "en": "Back to my schedule"
              }
            }
          ]
        }
      ],
      "hint": {
        "en": "Overrides the weekly time program of heating circuit 0. Comfort, Normal and Eco apply around the clock until you choose 'Back to my schedule', which restores the schedule that was in place before the first override. Eco uses the installation's reduced level."
      }
    },
    {
      "id": "set-heating-thermostat",
      "title": {
        "en": "Set heating target temperature to [[temperature]] °C"
      },
      "titleFormatted": {
        "en": "Set heating target temperature to [[temperature]] °C"
      },
      "args": [
        {
          "name": "temperature",
          "type": "number",
          "min": 3,
          "max": 37,
          "step": 1,
          "title": {
            "en": "Temperature"
          }
        }
      ]
    },
    {
      "id": "set-hot-water-thermostat",
      "title": {
        "en": "Set hot water Normal target temperature to [[temperature]] °C"
      },
      "titleFormatted": {
        "en": "Set hot water Normal target temperature to [[temperature]] °C"
      },
      "args": [
        {
          "name": "temperature",
          "type": "number",
          "min": 10,
          "max": 60,
          "step": 1,
          "title": {
            "en": "Temperature"
          }
        }
      ]
    },
    {
      "id": "do-one-time-hot-water-charge",
      "title": {
        "en": "Set one time hot water charge"
      },
      "titleFormatted": {
        "en": "Set one time hot water charge to [[active]]"
      },
      "args": [
        {
          "name": "active",
          "type": "dropdown",
          "values": [
            {
              "id": "activate",
              "title": {
                "en": "Active"
              }
            },
            {
              "id": "deactivate",
              "title": {
                "en": "Inactive"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "set-hot-water-mode",
      "title": {
        "en": "Set hot water mode"
      },
      "titleFormatted": {
        "en": "Set hot water mode to [[mode]]"
      },
      "args": [
        {
          "name": "mode",
          "type": "dropdown",
          "values": [
            {
              "id": "efficient",
              "title": {
                "en": "Eco"
              }
            },
            {
              "id": "efficientWithMinComfort",
              "title": {
                "en": "Comfort"
              }
            },
            {
              "id": "off",
              "title": {
                "en": "Off"
              }
            },
            {
              "id": "eco",
              "title": {
                "en": "Eco (boiler)"
              }
            },
            {
              "id": "comfort",
              "title": {
                "en": "Comfort (boiler)"
              }
            },
            {
              "id": "balanced",
              "title": {
                "en": "Balanced (boiler)"
              }
            }
          ]
        }
      ],
      "hint": {
        "en": "Hot water has its own operating mode, separate from the heating circuit — this is the Eco/Comfort setting shown under hot water in the ViCare app. Heat pumps offer Eco, Comfort and Off; the modes marked (boiler) exist only on boilers and will be refused on a heat pump."
      }
    },
    {
      "id": "set-hot-water-thermostat2",
      "title": {
        "en": "Set hot water Temp 2 target temperature to [[temperature]] °C"
      },
      "titleFormatted": {
        "en": "Set hot water Temp 2 target temperature to [[temperature]] °C"
      },
      "args": [
        {
          "name": "temperature",
          "type": "number",
          "min": 10,
          "max": 60,
          "step": 1,
          "title": {
            "en": "Temperature"
          }
        }
      ]
    },
    {
      "id": "set-fuelcell-mode",
      "title": {
        "en": "Set fuel cell mode to [[mode]]"
      },
      "titleFormatted": {
        "en": "Set fuel cell mode to [[mode]]"
      },
      "args": [
        {
          "name": "mode",
          "type": "dropdown",
          "values": [
            {
              "id": "standby",
              "title": {
                "en": "Standby"
              }
            },
            {
              "id": "maintenance",
              "title": {
                "en": "Maintenance"
              }
            },
            {
              "id": "heatControlled",
              "title": {
                "en": "Heat controlled"
              }
            },
            {
              "id": "economical",
              "title": {
                "en": "Economical"
              }
            },
            {
              "id": "ecological",
              "title": {
                "en": "Ecological"
              }
            }
          ]
        }
      ]
    }
  ],
